@import "tailwindcss";

:root {
  --ink: #f7f8f4;
  --muted: #8d948f;
  --panel: rgba(18, 22, 21, 0.88);
  --panel-strong: #141918;
  --line: rgba(255, 255, 255, 0.08);
  --acid: #c9f65b;
  --water: #5ddcff;
  --smoke: #ff8b72;
  --food: #ffbd5a;
  --task: #a890ff;
}

* {
  box-sizing: border-box;
}

html {
  background: #080b0a;
  color-scheme: dark;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 15% -5%, rgba(83, 121, 87, 0.15), transparent 32rem),
    linear-gradient(145deg, #090c0b 0%, #0b0e0d 50%, #090b0b 100%);
  color: var(--ink);
  font-family: var(--font-geist-sans), Arial, Helvetica, sans-serif;
  min-width: 320px;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.app-shell {
  min-height: 100vh;
  overflow: hidden;
  padding: 28px clamp(18px, 4vw, 64px) 32px;
  position: relative;
}

.app-shell::before {
  background-image: linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
  background-size: 42px 42px;
  content: "";
  inset: 0;
  mask-image: linear-gradient(to bottom, black, transparent 70%);
  pointer-events: none;
  position: absolute;
}

.ambient {
  border-radius: 50%;
  filter: blur(2px);
  opacity: .5;
  pointer-events: none;
  position: absolute;
}

.ambient-one {
  animation: drift 12s ease-in-out infinite;
  background: radial-gradient(circle, rgba(201, 246, 91, .16), transparent 70%);
  height: 520px;
  right: -180px;
  top: 80px;
  width: 520px;
}

.ambient-two {
  animation: drift 15s ease-in-out -4s infinite reverse;
  background: radial-gradient(circle, rgba(93, 220, 255, .1), transparent 70%);
  bottom: 18%;
  height: 450px;
  left: -220px;
  width: 450px;
}

.topbar,
.hero,
.metric-grid,
.content-grid,
.timeline-panel,
footer {
  margin-inline: auto;
  max-width: 1280px;
  position: relative;
  z-index: 1;
}

.topbar {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.brand {
  align-items: center;
  display: flex;
  gap: 13px;
}

.brand-mark {
  align-items: center;
  background: var(--acid);
  border-radius: 12px;
  box-shadow: 0 0 28px rgba(201, 246, 91, .16);
  color: #11160e;
  display: flex;
  font-size: 19px;
  font-weight: 850;
  height: 43px;
  justify-content: center;
  transform: rotate(-3deg);
  width: 43px;
}

.eyebrow {
  color: var(--muted);
  font-family: var(--font-geist-mono), monospace;
  font-size: 10px;
  font-weight: 680;
  letter-spacing: .18em;
  margin: 0 0 4px;
}

.brand h1 {
  font-size: 16px;
  letter-spacing: -.02em;
  margin: 0;
}

.day-status {
  align-items: center;
  background: rgba(255, 255, 255, .035);
  border: 1px solid var(--line);
  border-radius: 14px;
  display: flex;
  gap: 11px;
  padding: 10px 14px;
}

.day-status div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.day-status strong {
  font-size: 11px;
  font-weight: 650;
}

.day-status span:last-child {
  color: var(--muted);
  font-size: 10px;
}

.status-dot,
.live-pill i {
  animation: softPulse 2.2s ease-out infinite;
  background: var(--acid);
  border-radius: 50%;
  box-shadow: 0 0 0 4px rgba(201, 246, 91, .08);
  height: 7px;
  width: 7px;
}

.hero {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  padding: clamp(56px, 8vw, 100px) 0 34px;
}

.hero-kicker {
  color: var(--acid);
  font-family: var(--font-geist-mono), monospace;
  font-size: 11px;
  letter-spacing: .16em;
  margin: 0 0 15px;
