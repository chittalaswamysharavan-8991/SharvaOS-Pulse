  width: 35px;
}

.progress-ring::after {
  background: #151a19;
  border-radius: 50%;
  content: "";
  height: 27px;
  position: absolute;
  width: 27px;
}

.progress-ring b {
  font-size: 7px;
  font-weight: 650;
  position: relative;
  z-index: 1;
}

.content-grid {
  display: grid;
  gap: 14px;
  grid-template-columns: 1.12fr .88fr;
  margin-top: 14px;
}

.panel {
  border-radius: 24px;
  padding: clamp(19px, 2.5vw, 28px);
}

.panel-heading {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
}

.panel-heading h3 {
  font-size: 20px;
  font-weight: 560;
  letter-spacing: -.035em;
  margin: 0;
}

.live-pill {
  align-items: center;
  background: rgba(201, 246, 91, .06);
  border: 1px solid rgba(201, 246, 91, .12);
  border-radius: 20px;
  color: #a7b78c;
  display: flex;
  font-family: var(--font-geist-mono), monospace;
  font-size: 9px;
  gap: 7px;
  padding: 7px 10px;
}

.live-pill i {
  display: block;
  height: 5px;
  width: 5px;
}

.capture-tabs {
  background: rgba(0,0,0,.2);
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 14px;
  display: grid;
  gap: 5px;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 23px;
  padding: 5px;
}

.capture-tabs button {
  align-items: center;
  background: transparent;
  border: 0;
  border-radius: 10px;
  color: #777f7a;
  cursor: pointer;
  display: flex;
  font-size: 11px;
  font-weight: 580;
  gap: 7px;
  justify-content: center;
  padding: 10px;
  transition: background .25s ease, color .25s ease, transform .2s ease;
}

.capture-tabs button:hover {
  color: #dfe4df;
}

.capture-tabs button:active {
  transform: scale(.97);
}

.capture-tabs button.active {
  background: rgba(255,255,255,.075);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.04);
  color: white;
}

.capture-tabs span {
  font-size: 14px;
}

.capture-stage {
  min-height: 182px;
  padding-top: 22px;
}

.capture-view {
  align-items: center;
  animation: viewIn .42s cubic-bezier(.2,.8,.2,1) both;
  display: grid;
  gap: clamp(20px, 4vw, 40px);
  grid-template-columns: 130px 1fr;
  padding: 4px 8px 0;
}

.capture-orb {
  align-items: center;
  background: radial-gradient(circle at 40% 25%, #80e8ff, #1d8ca8 65%, #0c4e60);
  border: 1px solid rgba(149, 236, 255, .3);
  border-radius: 50%;
  box-shadow: inset 0 0 30px rgba(255,255,255,.16), 0 12px 38px rgba(30, 163, 194, .18);
  display: flex;
  height: 110px;
  justify-content: center;
  overflow: hidden;
  position: relative;
  width: 110px;
}

.capture-orb span {
  color: white;
  font-size: 28px;
  font-weight: 260;
  position: relative;
  z-index: 2;
}

.orb-wave {
  animation: waterWave 5s linear infinite;
  background: rgba(255,255,255,.18);
  border-radius: 45%;
  bottom: -55px;
  height: 100px;
  position: absolute;
  width: 150px;
}

.capture-view h4,
.food-form h4 {
  font-size: 23px;
  font-weight: 570;
  letter-spacing: -.04em;
  margin: 0 0 6px;
}

.capture-view p,
.food-form p {
  color: var(--muted);
  font-size: 11px;
  margin: 0;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 18px;
}

.quick-actions button,
.primary-action,
.food-types button {
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 10px;
  color: #dfe4df;
  cursor: pointer;
  font-size: 10px;
  font-weight: 600;
  padding: 9px 12px;
  transition: background .22s ease, border-color .22s ease, transform .18s ease;
}

.quick-actions button:hover {
