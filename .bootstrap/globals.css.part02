}

.hero h2 {
  font-size: clamp(35px, 5vw, 66px);
  font-weight: 560;
  letter-spacing: -.055em;
  line-height: .98;
  margin: 0;
}

.hero h2 span {
  color: #737b76;
  display: block;
}

.local-note {
  align-items: center;
  background: rgba(255, 255, 255, .025);
  border: 1px solid var(--line);
  border-radius: 16px;
  display: flex;
  gap: 12px;
  margin-bottom: 4px;
  max-width: 310px;
  padding: 13px 15px;
}

.local-note > span {
  color: var(--acid);
  font-size: 25px;
}

.local-note p {
  color: var(--muted);
  font-size: 10px;
  line-height: 1.45;
  margin: 0;
}

.local-note strong {
  color: #e9eee9;
  display: block;
  font-size: 11px;
  margin-bottom: 2px;
}

.metric-grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(4, 1fr);
}

.metric-card,
.panel {
  backdrop-filter: blur(22px);
  background:
    linear-gradient(145deg, rgba(255,255,255,.025), transparent 48%),
    var(--panel);
  border: 1px solid var(--line);
  box-shadow: 0 16px 50px rgba(0, 0, 0, .18);
}

.metric-card {
  align-items: center;
  border-radius: 20px;
  color: inherit;
  cursor: pointer;
  display: grid;
  font: inherit;
  gap: 12px;
  grid-template-columns: auto 1fr;
  min-height: 102px;
  overflow: hidden;
  padding: 18px;
  position: relative;
  text-align: left;
  touch-action: manipulation;
  transition: border-color .3s ease, transform .35s cubic-bezier(.2,.8,.2,1);
  user-select: none;
}

.metric-card:hover {
  border-color: rgba(255,255,255,.15);
  transform: translateY(-3px);
}

.metric-card:active {
  filter: brightness(1.08);
  transform: scale(.975);
}

.metric-card:focus-visible {
  border-color: var(--acid);
  outline: 3px solid rgba(201, 246, 91, .14);
}

.metric-icon {
  align-items: center;
  background: rgba(255,255,255,.045);
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 14px;
  display: flex;
  font-size: 19px;
  height: 45px;
  justify-content: center;
  width: 45px;
}

.water-card .metric-icon { color: var(--water); }
.smoke-card .metric-icon { color: var(--smoke); }
.food-card .metric-icon { color: var(--food); }
.task-card .metric-icon { color: var(--task); }

.metric-copy {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.metric-copy span {
  color: var(--muted);
  font-size: 11px;
}

.metric-copy strong {
  font-size: 17px;
  font-weight: 610;
  letter-spacing: -.025em;
}

.mini-progress {
  background: rgba(255,255,255,.045);
  bottom: 0;
  height: 2px;
  left: 0;
  position: absolute;
  width: 100%;
}

.mini-progress i {
  background: var(--water);
  box-shadow: 0 0 15px var(--water);
  display: block;
  height: 100%;
  transition: width .6s cubic-bezier(.2,.8,.2,1);
}

.metric-signal {
  align-items: flex-end;
  bottom: 15px;
  display: flex;
  gap: 3px;
  position: absolute;
  right: 17px;
}

.metric-signal i {
  animation: signal 1.5s ease-in-out infinite alternate;
  background: var(--smoke);
  border-radius: 4px;
  height: 5px;
  opacity: .55;
  width: 2px;
}

.metric-signal i:nth-child(2) { animation-delay: .2s; height: 9px; }
.metric-signal i:nth-child(3) { animation-delay: .4s; height: 13px; }

.metric-foot {
  bottom: 15px;
  color: #646b67;
  font-size: 9px;
  position: absolute;
  right: 16px;
}

.progress-ring {
  --progress: 0deg;
  align-items: center;
  background: conic-gradient(var(--task) var(--progress), rgba(255,255,255,.06) 0);
  border-radius: 50%;
  bottom: 13px;
  display: flex;
  height: 35px;
  justify-content: center;
  position: absolute;
  right: 14px;
