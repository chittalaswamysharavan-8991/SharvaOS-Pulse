.check:hover { border-color: var(--acid); transform: scale(1.05); }
.done .check { background: var(--acid); border-color: var(--acid); }

.remove {
  background: transparent;
  border: 0;
  color: #505652;
  cursor: pointer;
  font-size: 17px;
  opacity: 0;
  transition: color .2s ease, opacity .2s ease;
}

.todo-item:hover .remove { opacity: 1; }
.remove:hover { color: var(--smoke); }

.empty-state {
  align-items: center;
  border: 1px dashed rgba(255,255,255,.08);
  border-radius: 14px;
  color: var(--muted);
  display: flex;
  gap: 12px;
  margin-top: 1px;
  padding: 15px;
}

.empty-state > span {
  align-items: center;
  background: rgba(168,144,255,.08);
  border-radius: 9px;
  color: var(--task);
  display: flex;
  height: 32px;
  justify-content: center;
  width: 32px;
}

.empty-state p {
  font-size: 10px;
  line-height: 1.45;
  margin: 0;
}

.empty-state strong {
  color: #dfe4df;
  display: block;
}

.todo-footer {
  align-items: center;
  color: var(--muted);
  display: flex;
  font-size: 9px;
  gap: 10px;
  margin-top: 14px;
}

.todo-footer > div {
  background: rgba(255,255,255,.05);
  border-radius: 4px;
  flex: 1;
  height: 3px;
  overflow: hidden;
}

.todo-footer i {
  background: var(--task);
  display: block;
  height: 100%;
  transition: width .5s ease;
}

.timeline-panel {
  margin-top: 14px;
}

.timeline-total {
  color: var(--muted);
  font-family: var(--font-geist-mono), monospace;
  font-size: 9px;
}

.timeline {
  display: grid;
  gap: 7px;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 20px;
}

.timeline-entry {
  align-items: center;
  animation: itemIn .35s cubic-bezier(.2,.8,.2,1) var(--delay) both;
  background: rgba(255,255,255,.025);
  border: 1px solid rgba(255,255,255,.05);
  border-radius: 13px;
  display: grid;
  gap: 11px;
  grid-template-columns: auto 1fr auto;
  padding: 11px 13px;
}

.entry-icon {
  align-items: center;
  background: rgba(255,255,255,.04);
  border-radius: 9px;
  display: flex;
  height: 31px;
  justify-content: center;
  width: 31px;
}

.timeline-entry.water .entry-icon { color: var(--water); }
.timeline-entry.smoke .entry-icon { color: var(--smoke); }
.timeline-entry.food .entry-icon { color: var(--food); }

.timeline-entry > div:nth-child(2) {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.timeline-entry strong {
  font-size: 10px;
  font-weight: 580;
}

.timeline-entry span,
.timeline-entry time {
  color: var(--muted);
  font-size: 9px;
}

.empty-timeline {
  align-items: center;
  color: var(--muted);
  display: flex;
  font-size: 10px;
  gap: 12px;
  grid-column: 1 / -1;
  justify-content: center;
  min-height: 70px;
}

.pulse-ring {
  animation: ringPulse 2s ease-out infinite;
  border: 1px solid var(--acid);
  border-radius: 50%;
  height: 9px;
  width: 9px;
}

footer {
  align-items: center;
  color: #555c57;
  display: flex;
  font-family: var(--font-geist-mono), monospace;
  font-size: 8px;
  justify-content: space-between;
  letter-spacing: .06em;
  padding: 24px 3px 0;
  text-transform: uppercase;
}

footer p {
  margin: 0;
}

.toast {
  align-items: center;
  animation: toastIn .4s cubic-bezier(.2,.9,.2,1) both;
  backdrop-filter: blur(18px);
  background: rgba(30, 37, 33, .94);
  border: 1px solid rgba(201,246,91,.15);
  border-radius: 15px;
  bottom: 24px;
  box-shadow: 0 18px 50px rgba(0,0,0,.35);
  display: flex;
  gap: 10px;
  left: 50%;
  padding: 11px 14px;
  position: fixed;
  transform: translateX(-50%);
  z-index: 20;
}

